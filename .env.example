# Copy to .env and fill in. .env is gitignored and never committed.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: a separate key for day 2. Its page fires several calls per click on a
# public endpoint, so it gets a key that can be capped and revoked on its own.
# Falls back to DEEPSEEK_API_KEY when unset.
DEEPSEEK_API_KEY_DAY2=

# Optional: a separate key for day 3. It runs on deepseek-v4-pro, which costs
# 12x what flash does, and its page fires up to six calls per click on a public
# endpoint. Falls back to DEEPSEEK_API_KEY when unset.
DEEPSEEK_API_KEY_DAY3=
